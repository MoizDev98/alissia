CREATE TABLE public.document_types (
  id integer NOT NULL DEFAULT nextval('document_types_id_seq'::regclass),
  name text NOT NULL UNIQUE,
  status text DEFAULT 'ACTIVE'::text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT document_types_pkey PRIMARY KEY (id)
);
CREATE TABLE public.meal_logs (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id bigint NOT NULL,
  plan_id bigint,
  meal_date date NOT NULL DEFAULT CURRENT_DATE,
  meal_type character varying NOT NULL CHECK (meal_type::text = ANY (ARRAY['desayuno'::character varying, 'almuerzo'::character varying, 'cena'::character varying, 'snack'::character varying]::text[])),
  planned_text text,
  consumed_text text,
  status character varying NOT NULL DEFAULT 'planned'::character varying CHECK (status::text = ANY (ARRAY['planned'::character varying, 'completed'::character varying, 'skipped'::character varying]::text[])),
  estimated_calories integer CHECK (estimated_calories IS NULL OR estimated_calories >= 0),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT meal_logs_pkey PRIMARY KEY (id),
  CONSTRAINT meal_logs_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT meal_logs_plan_id_fkey FOREIGN KEY (plan_id) REFERENCES public.nutritional_plans(id)
);
CREATE TABLE public.nutritional_plans (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id bigint,
  plan_data jsonb NOT NULL,
  created_at timestamp with time zone DEFAULT now(),
  status character varying DEFAULT 'ACTIVE'::character varying,
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT nutritional_plans_pkey PRIMARY KEY (id),
  CONSTRAINT nutritional_plans_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.patient_profiles (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id bigint,
  weight numeric NOT NULL,
  height numeric NOT NULL,
  age integer NOT NULL,
  gender character varying NOT NULL,
  activity_level character varying NOT NULL,
  goal character varying NOT NULL,
  status character varying DEFAULT 'ACTIVE'::character varying,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  contextura character varying,
  body_analysis jsonb,
  analysis_updated_at timestamp with time zone,
  CONSTRAINT patient_profiles_pkey PRIMARY KEY (id),
  CONSTRAINT patient_profiles_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.recommendation_history (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id bigint NOT NULL,
  plan_id bigint,
  profile_snapshot jsonb NOT NULL,
  ai_response jsonb NOT NULL,
  model_name character varying,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  status character varying NOT NULL DEFAULT 'ACTIVE'::character varying CHECK (status::text = ANY (ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])),
  CONSTRAINT recommendation_history_pkey PRIMARY KEY (id),
  CONSTRAINT recommendation_history_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT recommendation_history_plan_id_fkey FOREIGN KEY (plan_id) REFERENCES public.nutritional_plans(id)
);
CREATE TABLE public.roles (
  id integer NOT NULL DEFAULT nextval('roles_id_seq'::regclass),
  name text NOT NULL UNIQUE,
  description text,
  status text DEFAULT 'ACTIVE'::text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT roles_pkey PRIMARY KEY (id)
);
CREATE TABLE public.user_objectives (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id bigint NOT NULL,
  goal_type character varying NOT NULL CHECK (goal_type::text = ANY (ARRAY['bajar'::character varying, 'mantener'::character varying, 'subir'::character varying]::text[])),
  target_weight numeric,
  pace character varying DEFAULT 'moderado'::character varying CHECK (pace::text = ANY (ARRAY['lento'::character varying, 'moderado'::character varying, 'rapido'::character varying]::text[])),
  notes text,
  is_active boolean NOT NULL DEFAULT true,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT user_objectives_pkey PRIMARY KEY (id),
  CONSTRAINT user_objectives_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.users (
  id integer NOT NULL DEFAULT nextval('users_id_seq'::regclass),
  role_id integer,
  document_type_id integer,
  document_number text NOT NULL UNIQUE,
  first_name text NOT NULL,
  last_name text NOT NULL,
  gender text,
  phone text,
  password text NOT NULL,
  status text DEFAULT 'ACTIVE'::text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  email text NOT NULL UNIQUE,
  CONSTRAINT users_pkey PRIMARY KEY (id),
  CONSTRAINT users_role_id_fkey FOREIGN KEY (role_id) REFERENCES public.roles(id),
  CONSTRAINT users_document_type_id_fkey FOREIGN KEY (document_type_id) REFERENCES public.document_types(id)
);
CREATE TABLE public.weight_logs (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id bigint NOT NULL,
  weight numeric NOT NULL CHECK (weight > 0::numeric AND weight < 500::numeric),
  measured_at timestamp with time zone NOT NULL DEFAULT now(),
  source character varying NOT NULL DEFAULT 'manual'::character varying CHECK (source::text = ANY (ARRAY['manual'::character varying, 'import'::character varying, 'device'::character varying]::text[])),
  note text,
  status character varying NOT NULL DEFAULT 'ACTIVE'::character varying CHECK (status::text = ANY (ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])),
  CONSTRAINT weight_logs_pkey PRIMARY KEY (id),
  CONSTRAINT weight_logs_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);